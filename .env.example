# ==============================================================================
# Personalized Health AI - Environment Configuration
# ==============================================================================

# Paste your Google Gemini API key below.
# (Note: In the case study prompt, 'LLM_API_KEY' and 'GEMINI_API_KEY' refer to the exact same key.
# You only need to paste your single Gemini API key here!)
GEMINI_API_KEY=

# Model Name: Set to your required Gemini model (e.g. gemini-3.6, gemini-2.0-flash, or gemini-1.5-flash)
GEMINI_MODEL=gemini-3.6
